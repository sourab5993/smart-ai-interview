# ========================================================
# Smart AI Interview Preparation & Evaluation Environment
# ========================================================

# Server Port (Default: 3000)
PORT=3000
NODE_ENV=development

# Browser Configuration (Auto-opens Google Chrome upon dev server start)
BROWSER=chrome
AUTO_OPEN_BROWSER=true

# Google Gemini API Key for dynamic interview question generation & post-interview evaluations
GEMINI_API_KEY=your_gemini_api_key_here

# App URL
APP_URL=http://localhost:3000

# ========================================================
# Supabase Configuration (PostgreSQL Database & Storage)
# ========================================================
# Find these in your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Direct PostgreSQL URI
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres

# ========================================================
# Database Configuration (MongoDB & Mongoose Fallback)
# ========================================================
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/smart_ai_interview
# MongoDB Atlas (Cloud Cluster):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_ai_interview?retryWrites=true&w=majority
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=smart_ai_interview
DB_USER=
DB_PASS=
DB_AUTH_SOURCE=admin

# ========================================================
# Authentication & JWT Security Configuration
# ========================================================
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# ========================================================
# Email OTP Verification (Nodemailer SMTP Configuration)
# ========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM_NAME="Smart AI Interview Coach"
