# Browser-safe Supabase project settings; keep RLS enabled
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Private server-only connection for the shared Gemini limiter, scheduled jobs,
# and the controlled migration runner. Never prefix with VITE_ or expose to clients.
# Copy the full Session Pooler URI from Supabase Dashboard > Connect.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Optional trusted PEM CA if the database certificate chain is not in the host trust store.
# Certificate validation remains enabled; do not use sslmode=no-verify.
SUPABASE_DB_SSL_CA=

# Private provider credential. Keep server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite
# Optional secondary fallback transcription providers
GROQ_API_KEY=
OPENAI_API_KEY=
# Shared database-backed per-user Gemini token bucket (defaults apply if omitted).
GEMINI_RATE_LIMIT_WINDOW_SECONDS=3600
GEMINI_RATE_LIMIT_BURST=5
# Optional operation-specific limits per window; configure only positive integers.
# GEMINI_RATE_LIMIT_QUESTION_GENERATION_PER_WINDOW=30
# GEMINI_RATE_LIMIT_ANSWER_EVALUATION_PER_WINDOW=90
# GEMINI_RATE_LIMIT_REPORT_GENERATION_PER_WINDOW=20
# GEMINI_RATE_LIMIT_AUDIO_TRANSCRIPTION_PER_WINDOW=30
# GEMINI_RATE_LIMIT_RESUME_ANALYSIS_PER_WINDOW=15
# GEMINI_RATE_LIMIT_JOB_MATCH_PER_WINDOW=20
# GEMINI_RATE_LIMIT_STUDY_PLAN_PER_WINDOW=20
# GEMINI_RATE_LIMIT_QUESTION_EXPLANATION_PER_WINDOW=60

# Required only when registering and invoking external scheduled callbacks.
SCHEDULER_SHARED_SECRET=

# Runtime
NODE_ENV=development
PORT=3000
API_JSON_BODY_LIMIT=2mb
API_FORM_BODY_LIMIT=64kb
