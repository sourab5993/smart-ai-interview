# ========================================================
# Smart AI Interview Preparation & Evaluation Environment
# ========================================================

# Server Port (Default: 3000)
PORT=3000
NODE_ENV=development

# Browser Configuration (Auto-opens Google Chrome upon dev server start)
BROWSER=chrome
AUTO_OPEN_BROWSER=true

# Google Gemini API Key for dynamic interview question generation & post-interview evaluations
# (Leave empty to use built-in offline universal question & evaluation engine)
GEMINI_API_KEY=your_gemini_api_key_here

# App URL (Optional for production deployment)
APP_URL=http://localhost:3000

# ========================================================
# Database Configuration (MongoDB & Mongoose)
# ========================================================

# OPTION 1: Full Connection URI (Recommended for MongoDB Atlas or direct URI)
# -----------------------------------------------------------------------------
# Local MongoDB instance:
MONGODB_URI=mongodb://127.0.0.1:27017/smart_ai_interview
#
# MongoDB Atlas (Cloud Cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_ai_interview?retryWrites=true&w=majority

# OPTION 2: Discrete / Modular Database Credentials
# (Used automatically if MONGODB_URI is left empty)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=smart_ai_interview
DB_USER=
DB_PASS=
DB_AUTH_SOURCE=admin

# ========================================================
# Authentication & JWT Security Configuration
# ========================================================
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# ========================================================
# Google Sign-In (OAuth 2.0 / Google Identity Services)
# ========================================================
# Obtain your free Client ID from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ========================================================
# Email OTP Verification (Nodemailer SMTP Configuration)
# ========================================================
# For sending real 6-digit OTP codes directly to candidate inboxes:
# Using Gmail (Use App Password, not regular password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM_NAME="Smart AI Interview Coach"
# Note: If SMTP credentials are empty, OTP codes are logged in the server terminal for development testing.


